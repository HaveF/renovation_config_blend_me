{
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":configMigration",
    "abandonments:recommended",
    ":rebaseStalePrs",    
    "group:definitelyTyped",    
    ":label(dependencies)",
    "npm:unpublishSafe",
    ":assignee(HaveF)"
  ],
  "pipenv": {
    "enabled": true
  },
  "timezone": "Asia/Shanghai",
  "schedule": [
    "after 12pm and before 2pm on Monday"
  ],
  "minimumReleaseAge": "15 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "schedule": [
      "* 0-3 1 * *"
    ]
  },
  "packageRules": [
    {
      "matchUpdateTypes": [
        "patch",
        "pin"
      ],
      "automerge": true
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    }
  ]
}
